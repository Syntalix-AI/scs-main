---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHead from '@/components/SectionHead.astro';
import Steps from '@/components/Steps.astro';
import Testimonials from '@/components/Testimonials.astro';
import CtaBanner from '@/components/CtaBanner.astro';
import { SITE } from '@/data/site';
import { webPage, breadcrumbs } from '@/lib/schema';

const title = 'About Syntalix Consultancy (Syntalix LLP)';
const description = 'Syntalix Consultancy (Syntalix LLP, LLPIN ACR-6280) is a Wadhwani NEN certified software, AI and ML team from India, building for clients since 2023.';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'About', path: '/about' }];
const facts = [['2023', 'Started building for clients'], ['2025', 'Registered as Syntalix LLP'], [SITE.llpin, 'LLP identification number'], ['3', 'Countries our clients are in']];
const details = [['Legal name', SITE.legalName], ['Trading name', SITE.name], ['LLPIN', SITE.llpin], ['Registered in', 'Uttar Pradesh, India'], ['Certification', SITE.certification], ['Email', SITE.email]];
---
<Base title={title} description={description} schema={[webPage('/about', title, description, 'AboutPage'), breadcrumbs(crumbs)]}>
  <PageHero image="pg-about" title="About Syntalix" lead="A software, AI and ML engineering team from India, building production systems for clients since 2023." crumbs={crumbs} />
  <section class="wrap section">
    <div class="story">
      <h2 class="heading">Our story</h2>
      <div class="story__body">
        <p>Syntalix started in 2023 as a small group of engineers taking on AI and web projects for clients in India and abroad. The work grew, so in 2025 we registered as Syntalix LLP (LLPIN {SITE.llpin}).</p>
        <p>We are certified by the {SITE.certification}. Today we design and build web platforms, LLM features and agentic systems, and we still work the way we started: a small senior team, close to the client, shipping every week.</p>
      </div>
    </div>
    <div class="facts">{facts.map(([a, b]) => <div><b>{a}</b><span>{b}</span></div>)}</div>
  </section>
  <section class="band">
    <div class="wrap">
      <SectionHead title="How we work" />
      <Steps steps={[
        ['Understand', 'We start with your business problem, data and constraints, and agree what success looks like.'],
        ['Ship early', 'Weekly demos on a preview link. Working software beats a big reveal.'],
        ['Build it properly', 'Tests, logging and monitoring from day one, so production stays healthy.'],
        ['Stay honest', 'Fixed quotes, plain reporting, and we say no to work we cannot do well.'],
      ]} />
    </div>
  </section>
  <section class="wrap section">
    <SectionHead title="What we are good at" lead="One small senior team across AI and full-stack engineering." link={{ href: '/services', label: 'All services' }} />
    <div class="rows">
      <div><h3>LLM engineering</h3><p>RAG, fine-tuning, evaluation and guardrails. <a href="/services/llm-engineering">LLM engineering services</a></p></div>
      <div><h3>Agentic systems</h3><p>Multi-step agents wired into real tools, with human review. <a href="/services/agentic-systems">Agentic AI systems</a></p></div>
      <div><h3>AI and ML infrastructure</h3><p>Pipelines, model serving and monitoring on the major clouds. <a href="/services/ai-ml-infrastructure">Machine learning infrastructure</a></p></div>
      <div><h3>Full-stack engineering</h3><p>Astro, Next.js, React Native, FastAPI and PostgreSQL. <a href="/services/web-mobile-development">Web and mobile development</a></p></div>
    </div>
  </section>
  <section class="wrap section">
    <SectionHead title="Company details" size="heading" />
    <dl class="details">{details.map(([a, b]) => <div><dt>{a}</dt><dd>{b}</dd></div>)}</dl>
    <p class="follow">Follow our work on <a href={SITE.linkedin} rel="me noopener">LinkedIn</a>, see client reviews on <a href={SITE.clutch} rel="noopener">Clutch</a> and <a href={SITE.fiverr} rel="noopener">Fiverr</a>, and our open source on <a href={SITE.github} rel="me noopener">GitHub</a>.</p>
  </section>
  <Testimonials />
  <CtaBanner />
</Base>
<style>
  .story { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 80px; }
  .story__body { display: flex; flex-direction: column; gap: 20px; font-size: 18px; line-height: 1.7; color: var(--ink-muted); }
  .facts { margin-top: 64px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .facts div { padding-top: 20px; border-top: 2px solid var(--ink); display: flex; flex-direction: column; gap: 6px; }
  .facts b { font-size: clamp(28px, 3vw, 40px); font-weight: 800; letter-spacing: -0.02em; white-space: nowrap; } .facts span { font-size: 15px; color: var(--ink-muted); }
  .details { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 48px; }
  .details div { padding: 20px 0; border-top: 1px solid var(--line-strong); }
  .details dt { font-size: 14px; color: var(--ink-subtle); } .details dd { margin: 6px 0 0; font-size: 18px; font-weight: 600; overflow-wrap: anywhere; }
  .follow { margin-top: 32px; font-size: 17px; color: var(--ink-muted); }
  @media (max-width: 900px) { .story { grid-template-columns: minmax(0, 1fr); gap: 24px; } .facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } .details { grid-template-columns: minmax(0, 1fr); } }
</style>
