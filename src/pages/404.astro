---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import { photo } from '@/lib/images';
---
<Base title="Page not found" description="This page could not be found. Head to the Syntalix homepage, our services, client case studies or the contact page instead." noindex>
  <section class="nf hero-light">
    <Image src={photo('pg-404')} alt="" widths={[800, 1400, 2200]} sizes="100vw" loading="eager" style="object-position:60% 50%" />
    <div class="scrim-light"></div>
    <div class="wrap nf__in">
      <span class="subtle">Error 404</span>
      <h1 class="display-xl">This page wandered off</h1>
      <p class="lead">The link may be old or mistyped. Here is where most people are heading.</p>
      <div class="btns"><a class="btn btn--primary" href="/">Back to home</a><a class="btn btn--secondary" href="/services">Services</a><a class="btn btn--secondary" href="/case-studies">Case studies</a><a class="btn btn--secondary" href="/contact">Contact us</a></div>
    </div>
  </section>
</Base>
<style>
  .nf { background: #d8d2cb; }
  .nf__in { position: relative; min-height: 700px; padding-top: 120px; padding-bottom: 80px; display: flex; flex-direction: column; gap: 22px; max-width: calc(700px + 2 * var(--gutter)); margin: 0; }
</style>
