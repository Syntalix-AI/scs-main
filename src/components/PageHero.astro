---
import { Image } from 'astro:assets';
import Crumbs from './Crumbs.astro';
import { photo } from '@/lib/images';
interface Props { image: string; title: string; lead: string; crumbs: { name: string; path: string }[]; tone?: 'dark' | 'light'; bg?: string; height?: number; position?: string }
const { image, title, lead, crumbs, tone = 'dark', bg = '#e6d5b8', height = 560, position = '65% 50%' } = Astro.props;
---
<section class:list={['ph', tone === 'dark' ? 'hero-dark' : 'hero-light']} style={`--h:${height}px;${tone === 'light' ? `background:${bg}` : ''}`}>
  <Image src={photo(image)} alt="" widths={[480, 800, 1400, 2200]} sizes="100vw" quality={62} loading="eager" fetchpriority="high" style={`object-position:${position}`} />
  {tone === 'dark' ? <div class="scrim"></div> : <div class="scrim-light"></div>}
  <div class="wrap hero-inner ph__in">
    <Crumbs items={crumbs} />
    <h1 class="display-xl">{title}</h1>
    <p class="lead">{lead}</p>
    <slot />
  </div>
</section>
<style>
  .ph__in { min-height: var(--h); padding-top: 96px; padding-bottom: 72px; max-width: calc(820px + 2 * var(--gutter)); margin: 0; }
  .ph .display-xl { font-size: clamp(38px, 4.7vw, 68px); max-width: 720px; }
  .ph .lead { max-width: 560px; }
  @media (max-width: 900px) { .ph__in { min-height: 0; padding-top: 180px; padding-bottom: 40px; } }
</style>
