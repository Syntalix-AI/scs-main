---
import { Image } from 'astro:assets';
import BrowserFrame from './BrowserFrame.astro';
import { shot, logo } from '@/lib/images';
import type { Project } from '@/data/projects';
interface Props { project: Project }
const { project: p } = Astro.props;
const t = p.tint!;
---
<article class="cc" style={`--c-bg:${t.bg};--c-fg:${t.fg};--c-muted:${t.muted};--c-accent:${t.accent}`}>
  <div class="cc__who">
    {p.logo === 'legalindia' && <span class="cc__logo cc__logo--dark"><Image src={logo('logo-legalindia')} alt="Legal India logo" width={44} height={36} /></span>}
    {p.logo === 'rays' && <span class="cc__logo"><Image src={logo('logo-rays')} alt="RAYS and RZILSS logo" width={44} height={44} /></span>}
    {!p.logo && <span class="cc__logo cc__logo--mono" aria-hidden="true">JT</span>}
    <span><b>{p.client}</b><small>{p.sector}</small></span>
  </div>
  <h3>{p.headline}</h3>
  <p><strong>What we did:</strong> {p.what}</p>
  <div class="chips">{p.chips.map((c) => <span class="chip">{c}</span>)}</div>
  <a class="cc__visit" href={p.url} rel="noopener">Visit {p.domain}</a>
  <div class="cc__shot" aria-hidden="true">
    <BrowserFrame src={shot(p.shot!)} domain={p.domain!} alt="" height={240} widths={[480, 800]} sizes="420px" />
  </div>
</article>
<style>
  .cc { position: relative; min-height: 640px; padding: var(--space-8); border-radius: var(--radius-xl); overflow: hidden; background: var(--c-bg); color: var(--c-fg); box-shadow: 0 0 0 1px rgba(15,23,42,0.06); display: flex; flex-direction: column; gap: 16px; }
  .cc__who { display: flex; align-items: center; gap: 12px; }
  .cc__who b { display: block; font-size: 19px; }
  .cc__who small { display: block; font-size: 13px; color: var(--c-muted); }
  .cc__logo { width: 52px; height: 52px; flex-shrink: 0; border-radius: 14px; background: #fff; display: grid; place-items: center; box-shadow: 0 0 0 1px rgba(15,23,42,0.08); }
  .cc__logo :global(img) { object-fit: contain; }
  .cc__logo--dark { border-radius: 26px; background: #1e293b; }
  .cc__logo--mono { border-radius: 26px; background: var(--c-fg); color: #fff4f6; font-weight: 800; }
  .cc h3 { font-size: 28px; line-height: 1.15; font-weight: 800; letter-spacing: -0.01em; }
  .cc p { font-size: 15px; color: var(--c-muted); }
  .cc p strong { color: var(--c-accent); }
  .cc .chip { box-shadow: none; color: var(--c-fg); font-size: 13px; }
  .cc__visit { font-weight: 700; color: var(--c-accent); }
  .cc__visit:hover { color: var(--c-fg); }
  .cc__shot { margin: auto -64px -40px 0; padding-top: 12px; pointer-events: none; }
  @media (max-width: 640px) { .cc { min-height: 0; padding: 24px; } .cc h3 { font-size: 24px; } .cc__shot { margin: 8px -48px -32px 0; } }
</style>
