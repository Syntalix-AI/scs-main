---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; domain: string; alt: string; height: number; widths?: number[]; sizes?: string; eager?: boolean }
const { src, domain, alt, height, widths = [480, 800, 1200, 1568], sizes = '(max-width: 640px) 100vw, 560px', eager = false } = Astro.props;
---
<div class="frame">
  <div class="frame__bar">
    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
    {domain}
  </div>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} style={`height:${height}px`} loading={eager ? 'eager' : 'lazy'} />
</div>
