---
import { Image } from 'astro:assets';
import { NAV } from '@/data/site';
import { logo } from '@/lib/images';
const current = Astro.url.pathname;
const active = (href: string) => current === href || (href !== '/' && current.startsWith(href + '/')) || (href === '/case-studies' && current.startsWith('/portfolio'));
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a href="/" class="brand" aria-label="Syntalix Consultancy home">
      <Image src={logo('syntalix-logo')} alt="" width={44} height={44} loading="eager" />
      <span>Syntalix Consultancy</span>
    </a>
    <nav aria-label="Primary" class="nav">
      {NAV.map((n) => <a href={n.href} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <a href="/contact" class="btn btn--primary hdr__cta">Book a free scoping call</a>
    <details class="menu">
      <summary aria-label="Open menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </summary>
      <nav aria-label="Mobile" class="menu__panel">
        {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href="/portfolio">Portfolio</a>
        <a href="/careers">Careers</a>
        <a href="/contact" class="btn btn--primary">Book a free scoping call</a>
      </nav>
    </details>
  </div>
</header>
<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: rgba(247,246,249,0.92); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); }
  .hdr__in { height: 80px; display: flex; align-items: center; gap: 32px; }
  .brand { display: flex; align-items: center; gap: 12px; color: var(--ink); font-size: 19px; font-weight: 700; letter-spacing: -0.01em; margin-right: auto; }
  .brand img { width: 44px; height: 44px; object-fit: contain; }
  .nav { display: flex; gap: 32px; font-weight: 500; }
  .nav a { color: var(--ink); }
  .nav a[aria-current] { color: var(--violet); }
  .hdr__cta { min-height: 46px; font-size: 15px; }
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; width: 44px; height: 44px; display: grid; place-items: center; border-radius: 12px; background: #fff; box-shadow: 0 0 0 1px var(--line-strong); cursor: pointer; color: var(--ink); }
  .menu summary::-webkit-details-marker { display: none; }
  .menu__panel { position: absolute; right: 0; top: 54px; width: min(320px, calc(100vw - 32px)); padding: 16px; border-radius: var(--radius-lg); background: #fff; box-shadow: var(--shadow-float); display: flex; flex-direction: column; gap: 4px; }
  .menu__panel a:not(.btn) { padding: 12px 8px; color: var(--ink); font-weight: 600; border-bottom: 1px solid var(--line); }
  .menu__panel .btn { margin-top: 10px; }
  @media (max-width: 1024px) { .nav, .hdr__cta { display: none; } .menu { display: block; } .hdr__in { height: 68px; } .brand span { font-size: 17px; } }
</style>
