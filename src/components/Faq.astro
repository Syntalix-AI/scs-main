---
interface Props { title: string; items: [string, string][] }
const { title, items } = Astro.props;
---
<div class="faq-grid">
  <h2 class="heading">{title}</h2>
  <div class="faq">
    {items.map(([q, a], i) => (
      <details open={i === 0}>
        <summary>{q}</summary>
        <p>{a}</p>
      </details>
    ))}
  </div>
</div>
