---
interface Props { title: string; items: [string, string][] }
const { title, items } = Astro.props;
---
<div class="faq-grid">
  <h2 class="heading">{title}</h2>
  <div class="faq">
    {items.map(([q, a]) => (
      <div class="faq__item">
        <h3 class="faq__q">{q}</h3>
        <p>{a}</p>
      </div>
    ))}
  </div>
</div>
