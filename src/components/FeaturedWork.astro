---
import '@fontsource/fraunces/latin-700.css';
import '@fontsource/sora/latin-700.css';
import { Image } from 'astro:assets';
import BrowserFrame from './BrowserFrame.astro';
import { shot, logo, photo } from '@/lib/images';
interface Props { only?: 'city-farmers' | 'rapidlink-logistics' }
const { only } = Astro.props;
---
<div class="fw">
  {only !== 'rapidlink-logistics' && (
  <div class="gw" style="background:#0C5478">
    <Image src={photo('glass-cf')} alt="" widths={[640, 1280]} sizes="(max-width: 1024px) 100vw, 1280px" class="gw__bg" />
    <article class="glass glass--cf">
      <div class="glass__copy">
        <div class="who"><Image src={logo('cityfarmers-icon')} alt="City Farmers logo" width={44} height={44} class="who__logo" /><span class="cf-name">City Farmers</span><span class="pill">Client project</span></div>
        <h3>An AI grow-guide web app for a seed brand</h3>
        <p>We designed and built the web app: scan a seed packet for stage-by-stage plant care and reminders, plus a retrieval-based AI guide that answers in Hindi, Hinglish or English and cites the page it used.</p>
        <div class="stats"><div><b>15</b><span>seed guides wired into the app</span></div><div><b>3</b><span>languages our AI guide answers in</span></div></div>
        <div class="glass__foot"><a class="btn cf-btn" href="/case-studies/city-farmers">Read the case study</a><span>Next.js, Supabase, retrieval-grounded AI</span></div>
      </div>
      <div class="glass__visual" aria-hidden="true">
        <div class="cf-shot"><BrowserFrame src={shot('cityfarmers')} domain="cityfarmers.in" alt="" height={250} widths={[480, 900]} sizes="470px" /></div>
        <div class="phone">
          <div class="phone__screen">
            <div class="phone__head"><b>Tomato</b><span>Day 20, leafy growth</span></div>
            <div class="phone__body">
              <span class="bar"><i></i></span>
              <b class="wk">This week</b>
              <span class="tip tip--sand">Pinch off the lowest leaves once the plant is 30 cm tall.</span>
              <span class="tip tip--leaf">Stake the stem before the first flowers appear.</span>
              <span class="tip tip--card"><b>Ask the AI:</b> Why are my leaves curling? <em>Answer cites Tomato guide, p.4</em></span>
            </div>
          </div>
        </div>
      </div>
    </article>
  </div>
  )}
  {only !== 'city-farmers' && (
  <div class="gw" style="background:#0B1A3A">
    <Image src={photo('glass-rl')} alt="" widths={[640, 1280]} sizes="(max-width: 1024px) 100vw, 1280px" class="gw__bg" />
    <article class="glass glass--rl">
      <div class="glass__visual rl-ui" aria-hidden="true">
        <div class="track">
          <b>Track shipment</b>
          <span><i class="on"></i>Picked up, New Delhi</span>
          <span><i class="on"></i>In transit, Varanasi hub</span>
          <span class="off"><i></i>Out for delivery, Kolkata</span>
        </div>
        <div class="pay"><span><small>Payment</small>Paid via Razorpay</span><em>Download waybill</em></div>
      </div>
      <div class="glass__copy">
        <div class="who"><Image src={logo('rapidlink-logo')} alt="RapidLink Logistics logo" width={48} height={48} class="who__logo who__logo--round" /><span class="rl-name">RAPIDLINK Logistics</span><span class="pill pill--amber">Client project</span></div>
        <h3>A booking, payments and tracking platform for a logistics company</h3>
        <p>We built the production website and booking platform: an instant quote engine, a three-step booking flow with live payments, carrier-agnostic waybill tracking and an admin panel for the operations team.</p>
        <div class="stats stats--amber"><div><b>3-step</b><span>booking with payment</span></div></div>
        <div class="glass__foot"><a class="btn rl-btn" href="/case-studies/rapidlink-logistics">Read the case study</a><span>Astro, Node, SQLite, Razorpay</span></div>
      </div>
    </article>
  </div>
  )}
</div>
<style>
  .fw { display: flex; flex-direction: column; gap: 40px; }
  .gw { position: relative; border-radius: var(--radius-2xl); overflow: hidden; }
  .gw :global(.gw__bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .glass { position: relative; min-height: 620px; padding: 64px; border-radius: var(--radius-2xl); color: #fff; box-shadow: var(--shadow-glass); display: grid; gap: 56px; }
  .glass--cf { background: rgba(12,84,120,0.72); grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
  .glass--rl { background: rgba(11,26,58,0.74); grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); }
  .glass__copy { display: flex; flex-direction: column; gap: 20px; }
  .who { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .who :global(.who__logo) { border-radius: 10px; }
  .who :global(.who__logo--round) { border-radius: 24px; background: #fff; object-fit: contain; }
  .cf-name { font: 700 22px Fraunces, serif; }
  .rl-name { font: 700 20px Sora, sans-serif; }
  .pill { padding: 4px 10px; border-radius: 999px; background: rgba(255,255,255,0.16); font: 600 13px var(--font-sans); }
  .pill--amber { background: rgba(242,167,59,0.2); color: #f7c77f; }
  .glass h3 { font: 800 clamp(30px, 3vw, 42px)/1.08 var(--font-sans); letter-spacing: -0.02em; }
  .glass p { font-size: 18px; color: #e3eef4; }
  .glass--rl p { color: #d3d9e8; }
  .stats { display: flex; gap: 32px; }
  .stats div { display: flex; flex-direction: column; }
  .stats b { font: 700 34px var(--font-sans); }
  .stats span { font-size: 14px; color: #bcd6e4; }
  .stats--amber b { color: #f2a73b; }
  .stats--amber span { color: #b8c1d6; }
  .glass__foot { margin-top: auto; display: flex; align-items: center; gap: 20px; flex-wrap: wrap; font-size: 15px; color: #bcd6e4; }
  .glass--rl .glass__foot { color: #b8c1d6; }
  .cf-btn { background: #486c30; color: #fff; border-radius: 26px; }
  .cf-btn:hover { background: #3b5a27; color: #fff; }
  .rl-btn { background: #f2a73b; color: #0b1a3a; border-radius: 12px; }
  .rl-btn:hover { background: #f7bb62; color: #0b1a3a; }
  .glass__visual { position: relative; min-height: 480px; }
  .cf-shot { position: absolute; left: -8px; top: 96px; width: min(470px, 90%); }
  .phone { position: absolute; right: 24px; top: 0; width: 280px; height: 560px; padding: 10px; border-radius: 42px; background: #0a3f5a; box-shadow: 0 30px 70px rgba(0,0,0,0.3); }
  .phone__screen { height: 100%; border-radius: 32px; overflow: hidden; background: #faf8f6; color: #213b46; }
  .phone__head { padding: 26px 20px; border-bottom: 1px solid #e2dad3; display: flex; flex-direction: column; }
  .phone__head b { font: 700 24px Fraunces, serif; color: #0c5478; }
  .phone__head span { font-size: 13px; color: #56676d; }
  .phone__body { padding: 18px 20px; display: flex; flex-direction: column; gap: 14px; font-size: 13px; line-height: 1.5; }
  .bar { height: 8px; border-radius: 4px; background: #dceaf1; } .bar i { display: block; width: 45%; height: 8px; border-radius: 4px; background: #0c5478; }
  .wk { font-size: 14px; }
  .tip { padding: 12px; border-radius: 12px; }
  .tip--sand { background: #f6ebdb; } .tip--leaf { background: #e4ecd9; } .tip--card { background: #fff; box-shadow: 0 0 0 1px #e2dad3; }
  .tip em { font-style: normal; color: #56676d; }
  .rl-ui { display: flex; flex-direction: column; justify-content: center; gap: 16px; min-height: 0; }
  .track { padding: 24px; border-radius: 20px; background: #fff; color: #0b1a3a; display: flex; flex-direction: column; gap: 14px; font-weight: 600; }
  .track b { font: 700 18px Sora, sans-serif; }
  .track span { display: flex; align-items: center; gap: 12px; }
  .track i { width: 12px; height: 12px; border-radius: 6px; box-shadow: inset 0 0 0 2px #7a8399; }
  .track i.on { background: #f2a73b; box-shadow: none; }
  .track .off { color: #6b7489; font-weight: 400; }
  .pay { padding: 20px 24px; border-radius: 20px; background: #14213d; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .pay span { display: flex; flex-direction: column; font-weight: 600; } .pay small { font-weight: 400; color: #a9b4cc; }
  .pay em { font-style: normal; padding: 10px 16px; border-radius: 10px; background: #f2a73b; color: #0b1a3a; font-weight: 700; font-size: 14px; }
  @media (max-width: 1024px) {
    .glass, .glass--cf, .glass--rl { grid-template-columns: minmax(0, 1fr); padding: 32px 24px; min-height: 0; gap: 32px; }
    .glass--rl .glass__visual { order: 2; }
    .glass--cf .glass__visual { min-height: 360px; }
    .cf-shot { display: none; }
    .phone { position: relative; right: auto; margin: 0 auto; width: 240px; height: 400px; }
  }
</style>
